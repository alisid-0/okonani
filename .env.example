# =============================================================================
# Okonani — single source of truth for local config and secrets
# Copy this file to `.env` and fill in your values.
# Do not create any other env files in this project.
# =============================================================================

# Firebase web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...

# App URLs
CLIENT_URL=http://localhost:5173
# Production site URL (used in order-notification emails for admin deep links)
# CLIENT_URL=https://okonani-dff36.web.app
VITE_USE_FIREBASE_EMULATORS=false
VITE_API_BASE_URL=

# Stripe — publishable key is safe for the browser (Checkout embed)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Secret keys (server-side only — never prefix with VITE_)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin panel access (comma-separated emails)
ADMIN_EMAILS=you@example.com

# New-order notifications (Resend) — who gets “order came in” emails
ORDER_NOTIFY_EMAIL=okonani.business@gmail.com

# Shippo (shipping labels) — https://apps.goshippo.com/settings/api
SHIPPO_API_TOKEN=shippo_test_...
SHIP_FROM_NAME=okonani
SHIP_FROM_STREET1=123 Main St
SHIP_FROM_STREET2=
SHIP_FROM_CITY=Austin
SHIP_FROM_STATE=TX
SHIP_FROM_ZIP=78701
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=you@example.com

# Email via Resend (new-order admin notify + customer shipped/delivered)
# Domain in MAIL_FROM must be verified in Resend (mailbox need not exist)
# https://resend.com
# RESEND_API_KEY=re_...
# MAIL_FROM=okonani <shipping@okonani.com>

# Social feeds (optional — improves Instagram; TikTok also tries public profile scrape)
# Instagram Graph API: long-lived token + Instagram user id
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Meta app credentials for Instagram oEmbed fallbacks
# META_APP_ID=
# META_APP_SECRET=
# Comma-separated post URLs if Graph API is not configured
# INSTAGRAM_POST_URLS=https://www.instagram.com/p/example/
# TikTok Display API user access token (from TikTok Login Kit)
# TIKTOK_ACCESS_TOKEN=
# Comma-separated TikTok video URLs as fallback
# TIKTOK_VIDEO_URLS=https://www.tiktok.com/@okonani/video/example

# Optional: path to Firebase service account JSON (for npm run bootstrap:admins against production)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# =============================================================================
# Okonani — single source of truth for local config and secrets
# Copy this file to `.env` and fill in your values.
# Do not create any other env files in this project.
# =============================================================================

# Firebase web app config (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=...
VITE_FIREBASE_APP_ID=...

# App URLs
CLIENT_URL=http://localhost:5173
VITE_USE_FIREBASE_EMULATORS=false
VITE_API_BASE_URL=

# Stripe live keys (server-side only — never prefix with VITE_)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin panel access (comma-separated emails)
ADMIN_EMAILS=you@example.com

# Social feeds (optional — improves Instagram; TikTok also tries public profile scrape)
# Instagram Graph API: long-lived token + Instagram user id
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Meta app credentials for Instagram oEmbed fallbacks
# META_APP_ID=
# META_APP_SECRET=
# Comma-separated post URLs if Graph API is not configured
# INSTAGRAM_POST_URLS=https://www.instagram.com/p/example/
# TikTok Display API user access token (from TikTok Login Kit)
# TIKTOK_ACCESS_TOKEN=
# Comma-separated TikTok video URLs as fallback
# TIKTOK_VIDEO_URLS=https://www.tiktok.com/@okonani/video/example

# Optional: path to Firebase service account JSON (for npm run bootstrap:admins against production)
# Download from Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
